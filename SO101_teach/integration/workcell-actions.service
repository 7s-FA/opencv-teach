[Unit]
Description=SO-101 workcell ROS 2 Actions
After=network-online.target arm3-linear-controller.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/OpenCV_teach
Environment=ROS_DOMAIN_ID=40
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/OpenCV_teach/integration/ros_ws/install/setup.bash && exec /usr/bin/python3 /home/ubuntu/OpenCV_teach/integration/action_server.py'
KillMode=mixed
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
