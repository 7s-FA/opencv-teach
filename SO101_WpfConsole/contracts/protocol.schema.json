{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:so101:control:v1",
  "title": "SO-101 control wire protocol v1",
  "$defs": {
    "SessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "protocol_version"
      ]
    },
    "SessionInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "demo": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol_version",
        "session_generation",
        "bridge_instance_id",
        "demo"
      ]
    },
    "CommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "command": {
          "type": "string",
          "enum": [
            "BUILD_A",
            "LOAD_A",
            "BUILD_B",
            "LOAD_B",
            "BUILD_LOAD_A",
            "BUILD_LOAD_B",
            "PC_BUILD_LOAD_A",
            "PC_BUILD_LOAD_B",
            "BUILD_SLIDE",
            "LOAD_SLIDE",
            "PREPARE_HOME",
            "EMER_STOP",
            "RESTART",
            "RESET",
            "CLEAR_ERROR"
          ]
        }
      },
      "required": [
        "protocol_version",
        "session_generation",
        "request_id",
        "command"
      ]
    },
    "RequestRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "command": {
          "type": "string",
          "enum": [
            "BUILD_A",
            "LOAD_A",
            "BUILD_B",
            "LOAD_B",
            "BUILD_LOAD_A",
            "BUILD_LOAD_B",
            "PC_BUILD_LOAD_A",
            "PC_BUILD_LOAD_B",
            "BUILD_SLIDE",
            "LOAD_SLIDE",
            "PREPARE_HOME",
            "EMER_STOP",
            "RESTART",
            "RESET",
            "CLEAR_ERROR"
          ]
        },
        "arm": {
          "type": "string",
          "enum": [
            "arm2",
            "arm3"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "JOB",
            "CONTROL"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "RUNNING",
            "BUILD_DONE",
            "PAUSED",
            "UNKNOWN",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "CLEARED"
          ]
        },
        "detail": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "IDLE",
                "RUNNING",
                "PAUSED",
                "BUILD_DONE",
                "ERROR",
                "PENDING",
                "UNKNOWN",
                "STORAGE_PENDING",
                "NOT_FOUND",
                "CLEARED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "command",
        "arm",
        "kind",
        "state",
        "detail",
        "updated_at",
        "result_code"
      ]
    },
    "CommandReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "EXISTING_REQUEST",
            "VERSION_MISMATCH",
            "SESSION_EXPIRED",
            "INVALID_REQUEST",
            "INVALID_COMMAND",
            "ID_CONFLICT",
            "NOT_ALLOWED",
            "STORAGE_ERROR",
            "RESPONSE_UNKNOWN"
          ]
        },
        "detail": {
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol_version",
        "accepted",
        "code",
        "detail",
        "request"
      ]
    },
    "ArmSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arm": {
          "type": "string",
          "enum": [
            "arm2",
            "arm3"
          ]
        },
        "connection": {
          "type": "string",
          "enum": [
            "ONLINE",
            "COMM_LOST"
          ]
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "arm",
        "connection",
        "job",
        "control"
      ]
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "demo": {
          "type": "boolean"
        },
        "bridge_connection": {
          "type": "string",
          "enum": [
            "ONLINE",
            "COMM_LOST"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "arms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArmSnapshot"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "storage_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_arm": {
          "type": "string",
          "enum": [
            "arm2",
            "arm3"
          ]
        }
      },
      "required": [
        "protocol_version",
        "bridge_instance_id",
        "session_generation",
        "sequence",
        "demo",
        "bridge_connection",
        "observed_at",
        "arms",
        "storage_error",
        "active_arm"
      ]
    },
    "GatewayEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "snapshot",
            "state_changed",
            "connection_changed"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "protocol_version",
        "bridge_instance_id",
        "session_generation",
        "sequence",
        "event_type",
        "occurred_at",
        "snapshot"
      ]
    },
    "SupervisionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "arm": {
          "type": "string",
          "enum": [
            "arm2",
            "arm3"
          ]
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expires_in_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "protocol_version",
        "session_generation",
        "bridge_instance_id",
        "arm",
        "epoch",
        "nonce",
        "expires_in_ms"
      ]
    },
    "SupervisionAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "arm": {
          "type": "string",
          "enum": [
            "arm2",
            "arm3"
          ]
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "protocol_version",
        "session_generation",
        "bridge_instance_id",
        "arm",
        "epoch",
        "nonce"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHORIZED",
            "SESSION_EXPIRED",
            "SESSION_IN_USE",
            "INVALID_REQUEST",
            "INVALID_COMMAND",
            "VERSION_MISMATCH",
            "NOT_FOUND",
            "STORAGE_PENDING",
            "UNAVAILABLE",
            "REQUEST_EXPIRED"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "code",
        "detail"
      ]
    },
    "SessionClosed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "closed": {
          "const": true
        }
      },
      "required": [
        "protocol_version",
        "session_generation",
        "closed"
      ]
    },
    "UiLeaseChallenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "lease"
        },
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "expires_in_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "protocol_version",
        "bridge_instance_id",
        "session_generation",
        "nonce",
        "expires_in_ms"
      ]
    },
    "UiLeaseAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "lease_ack"
        },
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "bridge_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "session_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "bridge_instance_id",
        "session_generation",
        "nonce"
      ]
    },
    "SupervisionFrame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "supervision_challenge"
            },
            "payload": {
              "$ref": "#/$defs/SupervisionChallenge"
            }
          },
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "supervision_ack"
            },
            "payload": {
              "$ref": "#/$defs/SupervisionAck"
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ]
    }
  }
}
