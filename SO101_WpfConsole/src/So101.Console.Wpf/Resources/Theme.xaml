<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Canonical HMI design tokens. State always has a text label as well as color. -->
 <SolidColorBrush x:Key="PageBrush" Color="#E9EDEF"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="SubtleBrush" Color="#F3F5F6"/>
 <SolidColorBrush x:Key="HeaderBrush" Color="#182A35"/>
 <SolidColorBrush x:Key="InkBrush" Color="#1C2B33"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#52636E"/>
 <SolidColorBrush x:Key="BorderBrush" Color="#CCD5DA"/>
 <SolidColorBrush x:Key="ControlBorderBrush" Color="#778C98"/>
 <SolidColorBrush x:Key="HeaderAccentBrush" Color="#6FC3CE"/>
 <SolidColorBrush x:Key="HeaderMutedBrush" Color="#B7C8D1"/>
 <SolidColorBrush x:Key="HeaderBorderBrush" Color="#526A78"/>
 <SolidColorBrush x:Key="HeaderHintBrush" Color="#C4D1D8"/>
 <SolidColorBrush x:Key="InverseBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#006B80"/>
 <SolidColorBrush x:Key="AccentTintBrush" Color="#E5F1F3"/>
 <SolidColorBrush x:Key="OnlineBrush" Color="#246343"/>
 <SolidColorBrush x:Key="WarningBrush" Color="#8B5700"/>
 <SolidColorBrush x:Key="WarningTintBrush" Color="#FFF2D6"/>
 <SolidColorBrush x:Key="StopBrush" Color="#AA2929"/>
 <SolidColorBrush x:Key="StopTintBrush" Color="#FBE9E7"/>
 <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="{StaticResource PageBrush}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style x:Key="SectionNumber" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="HeaderStatus" TargetType="TextBlock"><Setter Property="Foreground" Value="#C4D1D8"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,0"/><Style.Triggers>
  <DataTrigger Binding="{Binding SystemTone}" Value="error"><Setter Property="Foreground" Value="#FFB8B3"/></DataTrigger>
  <DataTrigger Binding="{Binding SystemTone}" Value="warning"><Setter Property="Foreground" Value="#FFD27A"/></DataTrigger>
  <DataTrigger Binding="{Binding SystemTone}" Value="running"><Setter Property="Foreground" Value="#94D6DD"/></DataTrigger>
 </Style.Triggers></Style>
 <Style x:Key="ResultState" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,2,12,0"/><Style.Triggers>
  <DataTrigger Binding="{Binding State}" Value="실패"><Setter Property="Foreground" Value="{StaticResource StopBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding State}" Value="접수 거절"><Setter Property="Foreground" Value="{StaticResource StopBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding State}" Value="입력 오류"><Setter Property="Foreground" Value="{StaticResource StopBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding State}" Value="보류"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding State}" Value="결과 미확인"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding State}" Value="완료"><Setter Property="Foreground" Value="{StaticResource OnlineBrush}"/></DataTrigger>
 </Style.Triggers></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="18,14"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style TargetType="Button">
  <Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="44"/>
  <Setter Property="Background" Value="{StaticResource SubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
    <Border x:Name="FocusRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="4" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.9"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter TargetName="Frame" Property="Background" Value="{StaticResource PageBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="MinHeight" Value="64"/><Setter Property="Margin" Value="4,3"/><Setter Property="Padding" Value="12,8"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Definition.Code}" Value="EMER_STOP"><Setter Property="Foreground" Value="{StaticResource StopBrush}"/><Setter Property="Background" Value="{StaticResource StopTintBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StopBrush}"/></DataTrigger>
   <DataTrigger Binding="{Binding Definition.Code}" Value="RESET"><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource StopBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource StopBrush}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="50"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style x:Key="StateDot" TargetType="Border"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="CornerRadius" Value="1"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{StaticResource MutedBrush}"/><Style.Triggers>
  <DataTrigger Binding="{Binding ConnectionTone}" Value="online"><Setter Property="Background" Value="{StaticResource OnlineBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding ConnectionTone}" Value="running"><Setter Property="Background" Value="{StaticResource AccentBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding ConnectionTone}" Value="paused"><Setter Property="Background" Value="{StaticResource WarningBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding ConnectionTone}" Value="error"><Setter Property="Background" Value="{StaticResource StopBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding ConnectionTone}" Value="offline"><Setter Property="Background" Value="{StaticResource StopBrush}"/></DataTrigger>
 </Style.Triggers></Style>
 <Style x:Key="JobStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/><Style.Triggers>
  <DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Foreground" Value="{StaticResource StopBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding Tone}" Value="paused"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
  <DataTrigger Binding="{Binding Tone}" Value="running"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
 </Style.Triggers></Style>
 <DataTemplate x:Key="ArmStatusTemplate">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"><Border Style="{StaticResource StateDot}"/><TextBlock Text="{Binding Connection}" FontSize="12" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/></DockPanel>
   <TextBlock Grid.Row="1" Text="{Binding Job}" Style="{StaticResource JobStatus}"/>
   <TextBlock Grid.Row="2" Text="{Binding Control}" Foreground="{StaticResource MutedBrush}" FontSize="12" ToolTip="{Binding Detail}"/>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
